# LINE Developers > Messaging API. Never paste these values into a chat.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Discord Developer Portal > Application > Bot > Token
DISCORD_BOT_TOKEN=
# Owner passphrase for the OAuth consent screen; generate a long random value.
LINE_BRIDGE_OWNER_SECRET=
# Optional bearer token for local administration/testing. Generate a separate value.
LINE_BRIDGE_MCP_TOKEN=
LINE_BRIDGE_PUBLIC_URL=https://line.example.com
